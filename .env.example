# Railway Postgres — for local dev, prefer SSH tunnel host (127.0.0.1:PORT) not *.proxy.rlwy.net
# railway connect Postgres --ssh --tunnel-only -P 15434
DATABASE_URL=

# Shopify Partner app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_inventory,read_locations
SHOPIFY_APP_URL=

# S3 — same bucket as Ethos Employee (private uploads; server-side presign only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=
# Optional; default merchant-submissions
MERCHANT_UPLOAD_S3_PREFIX=merchant-submissions

# Ethos Employee integration (Phase 5+ link API, Phase 6+ submit)
# Employee API origin (no trailing slash), e.g. https://your-api.up.railway.app
ETHOS_INTEGRATION_API_URL=
# Must match Employee SHOPIFY_MERCHANT_INTEGRATION_API_KEY
ETHOS_INTEGRATION_API_KEY=

# Dev only — auto-link shop after OAuth (optional)
# ETHOS_DEV_SHOP_DOMAIN=ethos-merchant.myshopify.com
# ETHOS_DEV_SUPPLIER_ID=1
# ETHOS_DEV_SUPPLIER_SLUG=your-custom-supplier-slug
# ETHOS_DEV_AUTO_APPROVE_SUPPLIER=1

# Development-only: mock catalog UI without Shopify OAuth (never enable in production)
LOCAL_PREVIEW=0
